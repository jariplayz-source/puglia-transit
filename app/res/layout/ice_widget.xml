<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iceRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/ice_widget_bg">
  <TextView android:id="@+id/iceHead" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="🆘  EMERGENCY INFORMATION" android:textColor="#FF8A80" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06"/>
  <TextView android:id="@+id/iceName" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/iceBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="15sp" android:lineSpacingExtra="2dp"/>
</LinearLayout>
